<Window x:Class="SinhalaInput.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SinhalaInput Settings"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <CheckBox x:Name="EnabledCheckBox"
                  Content="Enable Sinhala transliteration"
                  Checked="OnEnabledCheckBoxToggled"
                  Unchecked="OnEnabledCheckBoxToggled"
                  Margin="0,0,0,12" />
        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Content="Start SinhalaInput when I sign in to Windows"
                  Checked="OnStartWithWindowsCheckBoxToggled"
                  Unchecked="OnStartWithWindowsCheckBoxToggled" />
        <TextBlock x:Name="StartupManagedText"
                   Text="Starting SinhalaInput when you sign in to Windows is managed by Windows: turn it on or off in Settings › Apps › Startup."
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <TextBlock x:Name="HotkeyText" Margin="0,12,0,0" />
    </StackPanel>
</Window>
