<Window x:Class="SinhalaInput.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EasyAkuru"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image x:Name="LogoImage" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Foreground="Gray" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding PublisherText}" />
        <TextBlock Text="{Binding AuthorText}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" />
        <Button Content="OK" IsDefault="True" IsCancel="True" Width="80" Margin="0,16,0,0"
                HorizontalAlignment="Right" Click="OnOkClicked" />
    </StackPanel>
</Window>
