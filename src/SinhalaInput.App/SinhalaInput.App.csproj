<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\SinhalaInput.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SinhalaInput.ico" LogicalName="SinhalaInput.App.Assets.SinhalaInput.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF and WinForms (used only for the NotifyIcon tray icon) both implicitly bring in
         "Application"; keep WPF's System.Windows.Application as the unqualified default and
         refer to System.Windows.Forms.Application/NotifyIcon with their full names. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SinhalaInput.Core\SinhalaInput.Core.csproj" />
    <ProjectReference Include="..\SinhalaInput.Platform.Windows\SinhalaInput.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
