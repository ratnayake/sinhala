<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1716: IKeyboardHook.Stop() is a pre-existing, fixed contract (see IKeyboardHook.cs)
         that the App project already codes against; it cannot be renamed here. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SinhalaInput.Platform.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UIAutomationClient/UIAutomationTypes (Caret/Win32CaretLocator.cs's UI Automation
         fallback) live in the WindowsDesktop shared framework. Referencing the framework
         directly - rather than setting UseWPF/UseWindowsForms - pulls in exactly those
         reference assemblies without adding a WPF/WinForms application model to this
         plain class library. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
