<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1716: IKeyboardHook.Stop() is a pre-existing, fixed contract (see IKeyboardHook.cs)
         that the App project already codes against; it cannot be renamed here. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SinhalaInput.Platform.Windows.Tests" />
  </ItemGroup>

</Project>
