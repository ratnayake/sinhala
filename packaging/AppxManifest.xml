<?xml version="1.0" encoding="utf-8"?>
<!--
  AppxManifest.xml for EasyAkuru.

  IDENTITY / SIGNING NOTE:
  Identity Name, Publisher and PublisherDisplayName below are the values Partner Center
  reserved for this app (Product identity page, Store ID 9P65C2RS1N87, package family name
  Ratcon.EasyAkuru_swc2syyz6eg42). They must not be changed: the Store rejects an upload
  whose identity doesn't match the reservation.

  The Store re-signs submitted packages with its own certificate, so a Store upload is
  built unsigned (Build-MsixPackage.ps1 -StoreUpload). For local sideload testing,
  Build-MsixPackage.ps1 -Sign signs with a self-signed certificate whose Subject is set to
  this exact Publisher string; that package only installs on a machine that explicitly
  trusts that certificate (see packaging/README.md).
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    IgnorableNamespaces="uap rescap desktop">

  <Identity
      Name="Ratcon.EasyAkuru"
      Publisher="CN=E7B0A46A-21DB-4DDA-BDA6-CCAB7E8753EA"
      Version="1.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>EasyAkuru</DisplayName>
    <PublisherDisplayName>Ratcon</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>EasyAkuru: type Sinhala anywhere in Windows. Phonetic ("Singlish") Latin keystrokes are transliterated into Sinhala Unicode in real time by a lightweight tray application.</Description>
  </Properties>

  <!--
    Win10 1809 (build 17763) is the earliest build with full support for the
    desktop-bridge/runFullTrust MSIX shape this classic WPF app uses. MaxVersionTested is the
    Windows 11 24H2 build; Windows only uses it for compatibility behaviour and does not
    block newer builds from installing the package.
  -->
  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.17763.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    Scale- and targetsize-qualified images in Assets\ (e.g. Square44x44Logo.scale-200.png,
    Square44x44Logo.targetsize-16_altform-unplated.png) are resolved through resources.pri,
    which Build-MsixPackage.ps1 generates with makepri before packing.
  -->
  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="EasyAkuru" Executable="EasyAkuru.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="EasyAkuru"
          Description="Type Sinhala anywhere in Windows with phonetic (Singlish) keystrokes."
          BackgroundColor="#8D153A"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#8D153A" />
      </uap:VisualElements>
      <Extensions>
        <!--
          Start at every sign-in, on by default. MSIX cannot run code at install time, so the
          very first run is the Store's "Launch" button (or Start menu); from then on Windows
          starts the app at sign-in. Users toggle it under Settings > Apps > Startup. Unpackaged
          builds use an HKCU Run value instead (see src/SinhalaInput.App/Settings/StartupRegistration.cs).
        -->
        <desktop:Extension
            Category="windows.startupTask"
            Executable="EasyAkuru.exe"
            EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EasyAkuruStartup" Enabled="true" DisplayName="EasyAkuru" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust is the capability a classic Win32/WPF app packaged via the desktop bridge
      needs to keep its normal, unsandboxed Win32 API access (SetWindowsHookEx, SendInput and
      the other P/Invokes SinhalaInput.Platform.Windows relies on). It is a restricted
      capability, so the Store submission must justify it (global keyboard hook for text input).
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
