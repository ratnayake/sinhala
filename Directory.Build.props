<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>Isuru Sampath Ratnayake</Authors>
    <Company>Ratcon</Company>
    <Product>EasyAkuru</Product>
  </PropertyGroup>

  <!-- Test projects don't need the extra analyzer/doc-comment strictness applied to shipping code. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <!-- CA1707: xUnit's Method_Scenario_Expected convention intentionally uses underscores. -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

</Project>
